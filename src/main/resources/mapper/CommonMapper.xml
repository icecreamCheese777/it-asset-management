<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.company.assetmgmt.itassetmanagement.mapper.CommonMapper">
    <select id="selectAllCategories" resultType="com.company.assetmgmt.itassetmanagement.model.Category">
        SELECT * FROM category ORDER BY id
    </select>
    <select id="selectCategoryById" resultType="com.company.assetmgmt.itassetmanagement.model.Category">
        SELECT * FROM category WHERE id = #{id}
    </select>
    <select id="selectAllDepartments" resultType="com.company.assetmgmt.itassetmanagement.model.Department">
        SELECT * FROM department
    </select>
    <insert id="insertCategory" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO category (name, value) VALUES (#{name}, #{value})
    </insert>
    <update id="updateCategory">
        UPDATE category SET name = #{name}, value = #{value} WHERE id = #{id}
    </update>
    <delete id="deleteCategory">
        DELETE FROM category WHERE id = #{id}
    </delete>
    <select id="countAssetsByCategoryId" resultType="int">
        SELECT COUNT(*) FROM asset WHERE category_id = #{categoryId}
    </select>
</mapper>