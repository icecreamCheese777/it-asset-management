<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.company.assetmgmt.itassetmanagement.controller.MainController"
            prefWidth="1200" prefHeight="800">

    <!-- 左侧导航栏 -->
    <left>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 20 10 20 10;" prefWidth="200">
            <Label text="IT 资产管理系统" textFill="WHITE" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 0 0 20 0;"/>

            <Button fx:id="btnNavAsset" text="资产列表" onAction="#switchToAssetList" maxWidth="Infinity" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10;"/>
            <Button fx:id="btnNavLog" text="操作日志" onAction="#switchToLogList" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-font-size: 14px; -fx-padding: 10;"/>
            <Button fx:id="btnNavCategory" text="分类管理" onAction="#switchToCategory" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-font-size: 14px; -fx-padding: 10;"/>
            <Button fx:id="btnNavDept" text="部门管理" onAction="#switchToDept" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-font-size: 14px; -fx-padding: 10;"/>
            <Region VBox.vgrow="ALWAYS" />
            <!-- 新增：系统操作按钮 -->
            <Button text="备份数据库" onAction="#handleBackupDb" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-font-size: 13px; -fx-padding: 8;"/>
            <Button text="恢复数据库" onAction="#handleRestoreDb" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #e67e22; -fx-font-size: 13px; -fx-padding: 8;"/>
            <Button text="退出系统" onAction="#handleExit" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-font-size: 13px; -fx-padding: 8;"/>
        </VBox>
    </left>

    <!-- 右侧内容区 -->
    <center>
        <StackPane fx:id="contentArea">

            <!-- 1. 资产列表视图 -->
            <VBox fx:id="assetListView" spacing="10" style="-fx-padding: 15;">
                <!-- 顶部操作栏 -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="新增资产" onAction="#handleAddAsset" />
                    <Button text="修改" onAction="#handleEditAsset" />
                    <Button text="删除" onAction="#handleDeleteAsset" />
                    <Button text="导出报表" onAction="#handleExportExcel" />
                    <Region HBox.hgrow="ALWAYS" />
                    <TextField fx:id="searchField" promptText="输入资产编号或名称搜索..." prefWidth="250"/>
                </HBox>

                <!-- 快捷过滤区 -->
                <VBox spacing="5" style="-fx-background-color: #f8f9fa; -fx-padding: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-radius: 5;">
                    <!-- 分类过滤 -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="分类:" style="-fx-font-weight: bold; -fx-min-width: 40;"/>
                        <FlowPane fx:id="categoryFilterPane" hgap="8" vgap="8" prefWrapLength="800"/>
                    </HBox>
                    <!-- 状态过滤 -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="状态:" style="-fx-font-weight: bold; -fx-min-width: 40;"/>
                        <FlowPane fx:id="statusFilterPane" hgap="8" vgap="8" prefWrapLength="800"/>
                    </HBox>
                    <!-- 部门过滤 -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="部门:" style="-fx-font-weight: bold; -fx-min-width: 40;"/>
                        <FlowPane fx:id="deptFilterPane" hgap="8" vgap="8" prefWrapLength="800"/>
                    </HBox>
                </VBox>

                <!-- 数据表格 -->
                <TableView fx:id="assetTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colAssetNo" text="资产编号" prefWidth="120"/>
                        <TableColumn fx:id="colName" text="资产名称" prefWidth="120"/>
                        <TableColumn fx:id="colCategory" text="类别" prefWidth="100"/>
                        <TableColumn fx:id="colDept" text="所属部门" prefWidth="100"/>
                        <TableColumn fx:id="colStatus" text="状态" prefWidth="80"/>
                        <!-- 新增两列 -->
                        <TableColumn fx:id="colUserName" text="使用人" prefWidth="100"/>
                        <TableColumn fx:id="colPortNumber" text="端口号" prefWidth="80"/>

                        <TableColumn fx:id="colParams" text="设备参数" prefWidth="150"/>
                        <TableColumn fx:id="colCreatedAt" text="入库时间" prefWidth="150"/>
                        <TableColumn fx:id="colUpdatedAt" text="更新时间" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- 2. 其他视图占位（目前先隐藏） -->
            <!-- 操作日志视图 -->
            <VBox fx:id="logListView" spacing="10" style="-fx-padding: 15;" visible="false" managed="false">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="系统操作审计记录" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="清除一年以前" onAction="#handleClearOldLogs" />
                    <Button text="刷新日志" onAction="#loadLogs" />
                </HBox>
                <TableView fx:id="logTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colLogTime" text="发生时间" prefWidth="150"/>
                        <TableColumn fx:id="colLogAction" text="操作类型" prefWidth="90"/>
                        <TableColumn fx:id="colLogAsset" text="操作资产" prefWidth="200"/>
                        <TableColumn fx:id="colLogUser" text="涉及使用人" prefWidth="100"/>
                        <TableColumn fx:id="colLogDetails" text="详细记录" prefWidth="360"/>
                        <TableColumn fx:id="colLogOperation" text="操作" prefWidth="80"/>
                    </columns>
                </TableView>
            </VBox>
            <!-- 分类管理视图 -->
            <VBox fx:id="categoryView" spacing="10" style="-fx-padding: 15;" visible="false" managed="false">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="新增分类" onAction="#handleAddCategory" />
                    <Button text="修改" onAction="#handleEditCategory" />
                    <Button text="删除" onAction="#handleDeleteCategory" />
                </HBox>
                <TableView fx:id="categoryTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCatId" text="分类ID" prefWidth="100"/>
                        <TableColumn fx:id="colCatName" text="分类名称" prefWidth="300"/>
                    </columns>
                </TableView>
            </VBox>
            <!-- 部门管理视图 -->
            <VBox fx:id="deptView" spacing="10" style="-fx-padding: 15;" visible="false" managed="false">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button text="新增部门" onAction="#handleAddDept" />
                    <Button text="修改" onAction="#handleEditDept" />
                    <Button text="删除" onAction="#handleDeleteDept" />
                </HBox>
                <TableView fx:id="deptTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colDeptId" text="部门ID" prefWidth="100"/>
                        <TableColumn fx:id="colDeptName" text="部门名称" prefWidth="300"/>
                    </columns>
                </TableView>
            </VBox>

        </StackPane>
    </center>
</BorderPane>